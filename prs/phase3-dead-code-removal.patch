-
-export type Trigger =
-  | KeywordTrigger
-  | RegexTrigger
-  | IntentTrigger
-  | LLMTrigger
-  | CompositeTrigger
-  | ScheduledTrigger;
-
-// ============================================================================
-// 技能链定义
-// ============================================================================
-
-export interface SkillChain {
-  name: string;
-  description: string;
-  skills: Array<{
-    name: string;
-    condition?: (context: TriggerContext) => boolean;
-    timeout?: number;
-  }>;
-  orchestration: 'sequential' | 'parallel' | 'conditional';
-  stopOnFailure: boolean;
-}

-// ============================================================================
-// 触发上下文
-// ============================================================================
-
-export interface TriggerContext {
-  message: string;
-  userId?: string;
-  sessionId?: string;
-  channel?: string;
-  history?: Array<{ role: string; content: string }>;
-  metadata?: Record<string, unknown>;
-}

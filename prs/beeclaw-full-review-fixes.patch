-  /**
-   * 注册技能触发器
-   */
-  registerSkillTriggers(skillName: string, triggers: Trigger[]): void {
-    // 按优先级排序
-    const sorted = [...triggers].sort((a, b) => b.priority - a.priority);
-    this.skillTriggers.set(skillName, sorted);
-  }
-
-  /**
-   * 注册技能链

-+      const originalTokens = estimateMessageTokens(msg);
-+      let compressed = false;
-+
-+      if (msg.role === 'tool' && typeof msg.content === 'string') {
-+        const c = compressToolResult(msg.content);
-+        if (c !== msg.content) {
-+          msg.content = c;

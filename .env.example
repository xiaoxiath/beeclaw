# Beeclaw 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ============================================
# AI Provider 配置（必需）
# ============================================

# 智谱 AI API Key（推荐）
# 获取地址: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here

# MiniMax API Key（可选）
# 获取地址: https://www.minimaxi.com/
MINIMAX_API_KEY=your_minimax_api_key_here

# ============================================
# Feishu 飞书配置（可选，用于飞书机器人）
# ============================================

# 飞书应用 ID
# 获取地址: https://open.feishu.cn/app
LARK_BEECLAW_APPID=cli_xxxxxxxxxxxx

# 飞书应用 Secret
LARK_BEECLAW_AS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# 服务器配置（可选）
# ============================================

# 服务端口（默认: 3000）
BEECLAW_PORT=3000

# 服务主机（默认: 0.0.0.0）
BEECLAW_HOST=0.0.0.0

# ============================================
# 认证配置（可选）
# ============================================

# 启用认证（默认: false）
BEECLAW_AUTH_ENABLED=false

# 认证密码（如果启用认证）
BEECLAW_AUTH_PASSWORD=your_secure_password

# ============================================
# 日志配置（可选）
# ============================================

# 日志级别: debug, info, warn, error（默认: info）
BEECLAW_LOG_LEVEL=info

# ============================================
# Token 统计配置（可选）
# ============================================

# 是否显示 Token 消耗信息（默认: false）
# 设置为 true 可在每次回复后显示 token 使用量和上下文利用率
BEECLAW_SHOW_TOKEN_STATS=false

# ============================================
# 和风天气配置（可选，用于动态天气信息）
# ============================================

# 和风天气 API Host（默认: devapi.qweather.com）
# 生产环境使用: api.qweather.com
QWEATHER_APIHOST=devapi.qweather.com

# 和风天气 API KEY（推荐，简单易用）
# 获取地址: https://dev.qweather.com/
QWEATHER_KEY=your_qweather_key_here

# 和风天气 JWT Token（可选，更安全但配置复杂）
# 如果同时配置了 QWEATHER_KEY 和 QWEATHER_TOKEN，优先使用 QWEATHER_KEY
# QWEATHER_TOKEN=your_qweather_jwt_token_here

# 默认查询城市（默认: 北京）
QWEATHER_LOCATION=北京

# ============================================
# 搜索 API 配置（可选，用于 web_search 工具）
# ============================================

# 博查 AI API Key（推荐，国内高质量搜索）
# 获取地址: https://open.bochaai.com/
# 专为 AI 应用设计，国内稳定可用，可平替 Bing/Google
BOCHA_API_KEY=your_bocha_api_key_here

# Tavily API Key（推荐，国外高质量搜索）
# 获取地址: https://tavily.com/
# AI 优化的实时搜索，每月 1000 次免费调用
TAVILY_API_KEY=your_tavily_api_key_here

# 以下为传统搜索引擎 API（可选）

# Google Custom Search API
# 需要 API Key 和 Custom Search Engine ID
# GOOGLE_SEARCH_API_KEY=your_google_api_key
# GOOGLE_SEARCH_CX=your_custom_search_engine_id

# Bing Search API
# BING_SEARCH_API_KEY=your_bing_api_key

# Brave Search API
# BRAVE_SEARCH_API_KEY=your_brave_api_key

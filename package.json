{
  "name": "beeclaw",
  "version": "0.2.1",
  "description": "AI assistant with CLI and Feishu bot",
  "type": "module",
  "scripts": {
    "cli": "bun run src/entries/cli.ts",
    "bot": "bun run src/entries/bot.ts",
    "bot:web": "bun run src/entries/bot.ts --web",
    "web": "bun run src/entries/web.ts",
    "start": "bun run src/entries/bot.ts",
    "build:web": "bun scripts/build-web.ts",
    "dev:web": "bun scripts/build-web.ts --watch",
    "clean:web": "rm -rf src/web/client/dist",
    "build:embeddings": "bun run scripts/build-tool-embeddings.ts",
    "test": "bun test",
    "test:tool-selector": "bun test src/domain/agent/__tests__/hybrid-tool-selector.test.ts",
    "example:tool-selector": "bun run examples/hybrid-tool-selector.ts",
    "lint": "bun lint",
    "validate:imports": "bun scripts/validate-dynamic-imports.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:start:prod": "pm2 start ecosystem.config.cjs --env production",
    "pm2:start:no-daemon": "pm2 start ecosystem.flexible.cjs --env no_daemon",
    "pm2:stop": "pm2 stop beeclaw",
    "pm2:restart": "pm2 restart beeclaw",
    "pm2:reload": "pm2 reload beeclaw",
    "pm2:delete": "pm2 delete beeclaw",
    "pm2:logs": "pm2 logs beeclaw",
    "pm2:logs:err": "pm2 logs beeclaw --err",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 list",
    "pm2:info": "pm2 show beeclaw",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup",
    "pm2:flush": "pm2 flush",
    "pm2:reset": "pm2 reset beeclaw",
    "check:daemon": "./scripts/check-daemon.sh",
    "check:daemon:fix": "./scripts/check-daemon.sh --fix"
  },
  "dependencies": {
    "@hono/zod-validator": "0.7.6",
    "@larksuiteoapi/node-sdk": "1.59.0",
    "ajv": "8.18.0",
    "bunqueue": "2.5.5",
    "clipboardy": "5.3.1",
    "docx": "^9.6.1",
    "drizzle-orm": "^0.36.0",
    "hono": "4.12.5",
    "jiti": "2.6.1",
    "mathjs": "15.1.1",
    "monaco-editor": "0.55.1",
    "shell-quote": "1.8.3",
    "yaml": "2.8.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-router": "1.166.6",
    "@types/bun": "latest",
    "@types/dagre": "0.7.54",
    "@types/dockerode": "4.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/shell-quote": "1.7.5",
    "@xyflow/react": "12.10.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dagre": "0.8.5",
    "drizzle-kit": "^0.28.0",
    "glob": "13.0.6",
    "lucide-react": "0.577.0",
    "madge": "8.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.1",
    "tailwindcss-cli": "0.1.2",
    "ts-morph": "27.0.2",
    "typescript": "^5.6.0"
  }
}

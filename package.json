{
  "name": "beeclaw",
  "version": "0.2.0",
  "description": "AI assistant with CLI and Feishu bot",
  "type": "module",
  "scripts": {
    "cli": "bun run src/cli.ts",
    "bot": "bun run src/bot.ts",
    "start": "bun run src/bot.ts",
    "test": "bun test",
    "lint": "bun lint",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:start:prod": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop beeclaw",
    "pm2:restart": "pm2 restart beeclaw",
    "pm2:logs": "pm2 logs beeclaw",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 list"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.59.0",
    "bunqueue": "2.5.5",
    "clipboardy": "5.3.1",
    "yaml": "2.8.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}

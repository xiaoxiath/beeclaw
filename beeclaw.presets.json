{
  "development": {
    "env": "development",
    "agent": {
      "maxIterations": 50,
      "contextWindowTokens": 128000,
      "locale": "zh-CN",
      "streamEnabled": true
    },
    "compression": {
      "autoCompress": false,
      "compressAfterDays": 30,
      "keepOriginalDays": 30
    },
    "scoring": {
      "weights": {
        "recency": 0.3,
        "frequency": 0.2,
        "relevance": 0.3,
        "uniqueness": 0.15,
        "userMarked": 0.05
      }
    },
    "observability": {
      "logLevel": "debug",
      "structuredLogging": false,
      "tracingEnabled": true,
      "metricsEnabled": false
    }
  },
  "staging": {
    "env": "staging",
    "agent": {
      "maxIterations": 30,
      "contextWindowTokens": 128000,
      "locale": "zh-CN",
      "streamEnabled": true
    },
    "compression": {
      "autoCompress": true,
      "compressAfterDays": 14,
      "keepOriginalDays": 14
    },
    "scoring": {
      "weights": {
        "recency": 0.25,
        "frequency": 0.25,
        "relevance": 0.25,
        "uniqueness": 0.20,
        "userMarked": 0.05
      }
    },
    "observability": {
      "logLevel": "info",
      "structuredLogging": true,
      "tracingEnabled": true,
      "metricsEnabled": true
    }
  },
  "production": {
    "env": "production",
    "agent": {
      "maxIterations": 20,
      "contextWindowTokens": 128000,
      "locale": "zh-CN",
      "streamEnabled": true
    },
    "compression": {
      "autoCompress": true,
      "compressAfterDays": 3,
      "keepOriginalDays": 7,
      "archiveAfterDays": 90
    },
    "scoring": {
      "weights": {
        "recency": 0.25,
        "frequency": 0.20,
        "relevance": 0.30,
        "uniqueness": 0.20,
        "userMarked": 0.05
      }
    },
    "observability": {
      "logLevel": "warn",
      "structuredLogging": true,
      "tracingEnabled": true,
      "metricsEnabled": true
    },
    "retention": {
      "conversations": "60d",
      "facts": "forever",
      "decisions": "forever",
      "skills": "forever",
      "summaries": "180d"
    }
  }
}

{
  "server": {
    "port": 3000,
    "host": "0.0.0.0"
  },
  "auth": {
    "enabled": false,
    "tokens": [],
    "password": null
  },
  "cors": {
    "enabled": true,
    "origins": ["*"],
    "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allowHeaders": ["Content-Type", "Authorization"],
    "exposeHeaders": [],
    "maxAge": 86400,
    "credentials": true
  },
  "providers": [
    {
      "name": "openai",
      "type": "openai",
      "apiKey": "${OPENAI_API_KEY}",
      "baseUrl": "https://api.openai.com/v1",
      "models": ["gpt-4o", "gpt-4o-mini", "gpt-4-turbo"],
      "default": true
    }
  ],
  "agents": [
    {
      "id": "default",
      "name": "Default Assistant",
      "description": "A helpful AI assistant with memory capabilities",
      "provider": "openai",
      "model": "gpt-4o-mini",
      "systemPrompt": "You are a helpful AI assistant. You have access to memory tools to remember information about the user and recall past conversations.",
      "temperature": 0.7,
      "maxTokens": 4096,
      "tools": ["memory_ls", "memory_grep", "memory_read", "memory_write", "memory_record"]
    }
  ],
  "sessionStorage": {
    "type": "jsonl",
    "path": "./data/sessions"
  },
  "memory": {
    "type": "filesystem",
    "path": "./data/memory",
    "tools": {
      "enabled": ["memory_ls", "memory_grep", "memory_read", "memory_write", "memory_record"],
      "autoRecord": true
    },
    "retention": {
      "conversations": "90d",
      "facts": "forever",
      "decisions": "forever"
    }
  },
  "channels": {},
  "tools": {},
  "logging": {
    "level": "info",
    "format": "pretty"
  },
  "compression": {
    "enabled": true,
    "model": "glm-4.7-flash",
    "threshold": 0.8,
    "keepRecent": 8,
    "maxSummaryTokens": 1000,
    "strategy": "hybrid"
  },
  "extraction": {
    "enabled": true,
    "triggerPhrases": ["记住", "别忘了", "记一下", "记住这个", "保存", "记录", "存下来", "帮我记", "这个很重要"],
    "periodicInterval": 10,
    "confidenceThreshold": 0.9,
    "lowConfidenceThreshold": 0.7,
    "maxExtractionsPerRun": 20,
    "notifyOnHighConfidence": true,
    "sensitivePatterns": ["password", "passwd", "secret", "api_key", "token", "private_key", "密钥", "密码"]
  }
}

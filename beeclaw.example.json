{
  "server": {
    "port": 3000,
    "host": "0.0.0.0"
  },
  "auth": {
    "enabled": false,
    "tokens": [],
    "password": null
  },
  "cors": {
    "enabled": true,
    "origins": ["localhost"],
    "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allowHeaders": ["Content-Type", "Authorization"],
    "exposeHeaders": [],
    "maxAge": 86400,
    "credentials": true
  },
  "providers": [
    {
      "name": "openai",
      "type": "openai",
      "apiKey": "${OPENAI_API_KEY}",
      "baseUrl": "https://api.openai.com/v1",
      "models": ["gpt-4o", "gpt-4o-mini", "gpt-4-turbo"],
      "default": true
    }
  ],
  "agents": [
    {
      "id": "default",
      "name": "Default Assistant",
      "description": "A helpful AI assistant with memory capabilities",
      "provider": "openai",
      "model": "gpt-4o-mini",
      "systemPrompt": "You are a helpful AI assistant. You have access to memory tools to remember information about the user and recall past conversations.",
      "temperature": 0.7,
      "maxTokens": 4096,
      "tools": ["memory_ls", "memory_grep", "memory_read", "memory_write", "memory_record"]
    }
  ],
  "sessionStorage": {
    "type": "jsonl",
    "path": "./data/sessions"
  },
  "memory": {
    "type": "filesystem",
    "path": "./data/memory",
    "tools": {
      "enabled": ["memory_ls", "memory_grep", "memory_read", "memory_write", "memory_record"],
      "autoRecord": true
    },
    "retention": {
      "conversations": "90d",
      "facts": "forever",
      "decisions": "forever"
    }
  },
  "channels": {},
  "tools": {},
  "logging": {
    "level": "info",
    "format": "pretty"
  },
  "user": {
    "location": "北京",
    "locale": "zh-CN"
  },
  "weather": {
    "apiHost": "devapi.qweather.com",
    "apiKey": "${QWEATHER_API_KEY}",
    "defaultLocation": "北京"
  },
  "compression": {
    "enabled": true,
    "model": "glm-4.7-flash",
    "threshold": 0.8,
    "keepRecent": 8,
    "maxSummaryTokens": 1000,
    "strategy": "hybrid"
  },
  "extraction": {
    "enabled": true,
    "triggerPhrases": [],
    "periodicInterval": 10,
    "confidenceThreshold": 0.9,
    "lowConfidenceThreshold": 0.7,
    "maxExtractionsPerRun": 20,
    "notifyOnHighConfidence": true,
    "sensitivePatterns": ["password", "passwd", "secret", "api_key", "token", "private_key", "密钥", "密码"]
  },
  "mcp": {
    "enabled": true,
    "servers": [
      {
        "id": "filesystem",
        "name": "File System",
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "./data/workspace"],
        "enabled": true
      },
      {
        "id": "github",
        "name": "GitHub",
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-github"],
        "env": {
          "GITHUB_TOKEN": "${GITHUB_TOKEN}"
        },
        "tools": {
          "include": ["search_repositories", "get_file_contents", "create_issue", "list_issues"]
        }
      }
    ]
  },
  "hooks": {
    "enabled": true,
    "directories": ["./hooks"]
  },
  "web": {
    "enabled": true,
    "port": 3000,
    "host": "0.0.0.0",
    "auth": {
      "level": "token",
      "token": "${WEB_AUTH_TOKEN}",
      "basicUsers": [
        {
          "username": "admin",
          "password": "${WEB_ADMIN_PASSWORD}"
        }
      ]
    }
  }
}
